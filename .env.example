# MyMmorpg 环境变量样例（复制为 .env 后按需修改；勿提交真实生产密钥）
# cp .env.example .env

# ---- 运行 Profile ----
SPRING_PROFILES_ACTIVE=dev

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB_PLAYER=player_db
MYSQL_DB_BATTLE=battle_db
MYSQL_DB_ACTIVITY=activity_db
MYSQL_DB_UPDATE=update_db

# ---- Redis（单机）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Sentinel HA：SPRING_PROFILES_ACTIVE=...,redis-sentinel
# REDIS_SENTINEL_MASTER=mymmorpg-redis
# REDIS_SENTINEL_NODES=127.0.0.1:26379
# REDIS_PASSWORD=

# ---- 内部 API（服务间 HMAC）----
# 本地开发建议 false（与各服务 application-dev.yml 一致）；生产必须 true + 强密钥
INTERNAL_API_SECRET=dev-internal-api-secret
GAME_INTERNAL_API_ENABLED=false

# ---- RPC / 会话（player-service）----
RPC_SIGN_KEY=dev-rpc-sign-key
SERVER_SSL_ENABLED=false
SERVER_SSL_KEY_STORE_PASSWORD=
# 生产必须注入固定 RSA（Base64 PKCS8/X509），禁止每次启动临时生成
# SESSION_RSA_PRIVATE_KEY=
# SESSION_RSA_PUBLIC_KEY=

# ---- Admin 后台 ----
ADMIN_AUTH_ENABLED=false
ADMIN_IP_WHITELIST_ENABLED=true
ADMIN_HMAC_SECRET=dev-admin-hmac-secret
ADMIN_API_KEY=dev-admin-api-key

# ---- Admin AI 活动策划 Copilot（密钥勿提交仓库）----
# false=仅本地模板生成；true 且配置 ADMIN_AI_API_KEY 后调用兼容 OpenAI 的网关
ADMIN_AI_ENABLED=false
ADMIN_AI_API_KEY=
ADMIN_AI_BASE_URL=https://api.openai.com/v1
ADMIN_AI_MODEL=gpt-4o-mini
ADMIN_AI_TIMEOUT_MS=60000
ADMIN_AI_PROMPT_VERSION=activity-copilot-v1

# ---- 玩家 AI 顾问（读取当前角色 + 全服胜率/技能使用率）----
# mode=rule-coach（默认，对齐 MyLunarCore）；LLM 默认关闭，失败回退规则
PLAYER_AI_ENABLED=true
PLAYER_AI_MODE=rule-coach
PLAYER_AI_LLM_ENABLED=false
PLAYER_AI_API_KEY=
PLAYER_AI_BASE_URL=https://api.openai.com/v1
PLAYER_AI_MODEL=gpt-4o-mini

# ---- 智能 NPC 对话（场景服；默认规则回退，可开 LLM）----
GAME_NPC_AI_ENABLED=true
GAME_NPC_AI_LLM_ENABLED=false
GAME_NPC_AI_API_KEY=
GAME_NPC_AI_BASE_URL=https://api.openai.com/v1
GAME_NPC_AI_MODEL=gpt-4o-mini
GAME_NPC_AI_TIMEOUT_MS=15000

# ---- Center 场景路由（local=进程内目录；remote=预留远端中心服）----
GAME_CENTER_MODE=local
GAME_CENTER_LOCAL_NODE_ID=local
GAME_CENTER_REMOTE_BASE_URL=
GAME_CENTER_ADVERTISE_HOST=127.0.0.1
GAME_CENTER_ADVERTISE_PORT=8089
GAME_CENTER_REMOTE_TIMEOUT_MS=2500

# ---- 大世界 Zone / 分线（P1）----
GAME_SCENE_REGISTER_TO_CENTER=false
GAME_SCENE_MAX_PLAYERS_PER_LINE=100
GAME_SCENE_MAX_LINES_PER_MAP=20
GAME_SCENE_EMPTY_LINE_TTL_MS=300000
GAME_SCENE_RECONNECT_GRACE_MS=60000

# ---- 游戏网关 TCP / KCP（player-service）----
# KCP 默认与 TCP 同端口（UDP）；集成测试请设 GAME_KCP_ENABLED=false
GAME_NETTY_ENABLED=true
GAME_KCP_ENABLED=true
GAME_KCP_PORT=0
GAME_KCP_INTERVAL=20
GAME_KCP_MTU=1400
GAME_KCP_WRITE_LOW=32768
GAME_KCP_WRITE_HIGH=65536
GAME_KCP_DROP_PUSH=true

# 匹配队列分片（1=不分片，兼容历史 Redis key）
GAME_MATCH_QUEUE_SHARDS=1
GAME_MATCH_CROSS_SHARD=true

# 支付 HTTP 验签回调（对接方封装微信/支付宝 SDK；空则走沙箱 HMAC 或 Stub 拒绝）
SHOP_PAYMENT_VERIFY_URL_WECHAT=
SHOP_PAYMENT_VERIFY_URL_ALIPAY=

# ---- 微服务远程开关（默认单体模式全 false）----
GAME_PORT_REMOTE_ENABLED=false
GAME_SCENE_REMOTE_ENABLED=false
GAME_CHAT_REMOTE_ENABLED=false
GAME_BAG_REMOTE_ENABLED=false
GAME_SKILL_REMOTE_ENABLED=false
GAME_HALL_REMOTE_ENABLED=false
GAME_QUEST_REMOTE_ENABLED=false
GAME_MATCH_REMOTE_ENABLED=false
GAME_BATTLE_REMOTE_ENABLED=false
GAME_ACTIVITY_REMOTE_ENABLED=false
GAME_UPDATE_REMOTE_ENABLED=false
GAME_SHOP_REMOTE_ENABLED=false
GAME_GACHA_REMOTE_ENABLED=false
# 微服务模式下 player/admin 通过 Feign 调用 ai-service（默认单体嵌入，无需开启）
GAME_AI_REMOTE_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8995

PLAYER_SERVICE_URL=http://127.0.0.1:8989
SCENE_SERVICE_URL=http://127.0.0.1:8981
CHAT_SERVICE_URL=http://127.0.0.1:8982
BAG_SERVICE_URL=http://127.0.0.1:8983
SKILL_SERVICE_URL=http://127.0.0.1:8984
HALL_SERVICE_URL=http://127.0.0.1:8986
QUEST_SERVICE_URL=http://127.0.0.1:8987
MATCHMAKING_SERVICE_URL=http://127.0.0.1:8988
# 嵌入模式 admin 导入默认打 player；独立 shop-service 时改为 http://127.0.0.1:8990，并开 GAME_SHOP_REMOTE_ENABLED
SHOP_SERVICE_URL=http://127.0.0.1:8989
BATTLE_SERVICE_URL=http://127.0.0.1:8991
ACTIVITY_SERVICE_URL=http://127.0.0.1:8992
UPDATE_SERVICE_URL=http://127.0.0.1:8993
GACHA_SERVICE_URL=http://127.0.0.1:8994
AI_SERVICE_URL=http://127.0.0.1:8995
# ---- 支付验签 ----
# 开发可 MOCK；生产必须 SHOP_PAYMENT_MOCK_ENABLED=false，并至少配置一个渠道密钥（沙箱 HMAC）
# 生产样例请设 SHOP_PAYMENT_PRODUCTION_VERIFY=true（配合 application-prod.yml fail-fast）
SHOP_PAYMENT_PRODUCTION_VERIFY=false
SHOP_PAYMENT_MOCK_ENABLED=true
# FLYWAY_ENABLED=true
# SHOP_PAYMENT_CHANNEL_SECRET_WECHAT=
# SHOP_PAYMENT_CHANNEL_SECRET_ALIPAY=
# SHOP_PAYMENT_CHANNEL_SECRET_APP_STORE=
# SHOP_PAYMENT_CHANNEL_SECRET_GOOGLE_PLAY=

# ---- 可选中间件 ----
# Nacos 仅本机可关认证；共享环境请开启认证与 ACL
NACOS_ADDR=127.0.0.1:8848
# 生产若依赖战斗结束→活动进度等最终一致事件，必须开启
ROCKETMQ_ENABLED=false

# ---- TLog / GlobalUID ----
# 开启后使用 Kafka 风格异步 TLog（当前为异步日志模拟，可替换 KafkaTemplate）
GAME_TLOG_KAFKA_ENABLED=false
GAME_TLOG_KAFKA_TOPIC=mmorpg.tlog
# ---- 全局 UID（Snowflake）----
# <0 时由 Redis 自动申请 workerId，适配 K8s 动态扩缩；本地也可固定 0~31
GAME_UID_WORKER_ID=-1
GAME_UID_DATACENTER_ID=1
GAME_UID_AUTO_CLAIM=true

# ---- 会话 / 多端登录 ----
# single_device | multi_device_allowlist | kick_oldest
GAME_SESSION_LOGIN_POLICY=single_device
GAME_SESSION_MAX_SESSIONS=3
GAME_SESSION_TOKEN_TTL_HOURS=2
GAME_SESSION_BINDING_CHECK=false
GAME_SESSION_RECONNECT_NO_KICK_MS=60000

